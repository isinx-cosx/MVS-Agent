{
  "name": "mvs-agent",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "isinx-cosx",
  "type": "module",
  "description": "MVS Agent —— 通用 Agent 内核。v0：模型层（请求进，事件流出）",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "chat": "node src/cli/chat.ts",
    "chat:ollama": "node src/cli/chat.ts --profile ollama",
    "chat:deepseek": "node src/cli/chat.ts --profile deepseek",
    "tool": "node src/cli/tool.ts",
    "recovery": "node src/cli/recovery.ts",
    "policy": "node src/cli/policy.ts",
    "config": "node src/cli/config.ts",
    "skills": "node src/cli/skills.ts",
    "plugins": "node src/cli/plugins.ts",
    "serve": "node src/cli/serve.ts",
    "serve:ui": "node src/cli/serve.ts",
    "serve:fake": "node src/cli/serve.ts --profile fake --dev",
    "fake": "node scripts/fake-server.ts",
    "ui:build": "node tools/build-ui.mjs",
    "ui:build:dev": "node tools/build-ui.mjs --dev",
    "ui:typecheck": "tsc -p tsconfig.ui.json",
    "tools:check": "node tools/check-tools.mjs",
    "test": "node --test --test-isolation=none --import ./test/setup.mjs \"test/*.test.ts\" \"test/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
